# ---------------------------------------------------------------------------
# Abeg — environment configuration. Copy to `.env` and fill in your own keys.
#   cp .env.example .env
# NEVER commit your real .env — it is gitignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev with the bundled docker-compose Postgres uses this default:
DATABASE_URL=postgresql://abeg:abeg@localhost:5432/abeg

# --- LLM: OpenRouter (https://openrouter.ai) ---
# Create a key at https://openrouter.ai/keys. Set a spending limit on the key!
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Any tool-calling-capable model on OpenRouter works. Examples:
#   deepseek/deepseek-chat  ·  openai/gpt-4o-mini  ·  anthropic/claude-3.5-haiku
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Speech-to-text: Deepgram (https://deepgram.com) ---
# Create a key at https://console.deepgram.com. Needed only for voice input.
DEEPGRAM_API_KEY=your-deepgram-key-here
